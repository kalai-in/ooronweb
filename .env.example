NEXT_PUBLIC_VERSION = "1.0.0"

# API Configuration
NEXT_PUBLIC_API_URL=https://your-api-url.com
NEXT_PUBLIC_API_SUBURL=/customer

NEXT_PUBLIC_COUNTRY_DROPDOWN=false

# Google Maps JavaScript API key
NEXT_PUBLIC_MAP_API=xxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_WEB_NAME=xxxxxxxxxxxxxxxxxxxxxxxx

# Websocket url for chat module
NEXT_PUBLIC_WS_URL=wss://your-websocket-url.com

# Public site URL, used for canonical URLs and SEO metadata
NEXT_PUBLIC_BASE_URL=https://your-site.vercel.app

# Firebase Configuration
# Replace these with your project's Firebase configuration
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxxxxxx:web:xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase/FCM VAPID Key
# Used for identified push notifications
NEXT_PUBLIC_FIREBASE_VAPID_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4. Same GA4 property as the Firebase measurement ID above,
# but kept separate: this drives gtag.js directly, not Firebase.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Demo login credentials
# demo_mode now comes from the settings API response, not this env var.
NEXT_PUBLIC_DEMO_LOGIN_NO=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_DEMO_OTP=xxxxxx

NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=in
NEXT_PUBLIC_COUNTRY_DIAL_CODE=+91

# Keep this true. false switches next.config.mjs to output:"export", which drops
# src/middleware.js — zone URLs (/bhuj-quick/...) and language URLs (/ur/...)
# then 404. The build still succeeds, so the breakage is silent. See docs/OVERVIEW.md.
NEXT_PUBLIC_SEO = true

# SEO metadata
NEXT_PUBLIC_META_TITLE="eCommerce | Online Grocery Store | Fresh Produce and More"
NEXT_PUBLIC_META_DESCRIPTION="Shop for fresh groceries online at eCommerce. We offer a wide selection of high-quality produce, meat, dairy, and pantry staples, all delivered straight to your door."
NEXT_PUBLIC_META_KEYWORDS="grocery, supermarket, online, price, store, online groceries,onsline grocery delivery"
